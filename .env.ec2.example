# Environment configuration for SmartWarehouse Backend on AWS EC2
NODE_ENV=production

# Database Configuration (Docker Postgres on EC2)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT Secret
JWT_SECRET=sfwms_production_secret_key_2026

