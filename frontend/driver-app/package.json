{
  "name": "citymart-driver-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm run reverse:ports && expo start --offline",
    "reverse:ports": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3004 tcp:3004 && adb reverse tcp:3007 tcp:3007 && adb reverse tcp:3012 tcp:3012",
    "start": "expo start --offline",
    "start:lan": "expo start --offline --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android --offline",
    "ios": "expo start --ios --offline",
    "web": "expo start --web --offline",
    "prebuild": "npx expo prebuild --platform android",
    "build:apk": "cd android && gradlew.bat assembleDebug",
    "build:apk:release": "cd android && gradlew.bat assembleRelease",
    "run:phone": "npm run reverse:ports && cd android && gradlew.bat assembleDebug && adb install -r app/build/outputs/apk/debug/app-debug.apk && adb shell monkey -p vn.ctmart.driver -c android.intent.category.LAUNCHER 1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.395.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "typescript": "^5.3.3"
  },
  "private": true
}
