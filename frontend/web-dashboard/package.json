{
  "name": "web-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Hệ thống Điều hành & Quản trị Kho Thông minh SmartWarehouse",
  "author": "SmartWarehouse Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:dir": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.185.1",
    "lucide-react": "^1.46.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.smartwarehouse.dashboard",
    "productName": "SmartWarehouse Desktop",
    "electronVersion": "45.3.3",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartWarehouse Desktop"
    }
  }
}
