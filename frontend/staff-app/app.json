{
  "expo": {
    "name": "CityMart Staff",
    "slug": "citymart-staff-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền Camera để quét mã vạch và QR code của sản phẩm khi lấy hàng trong kho."
      }
    },
    "android": {
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
